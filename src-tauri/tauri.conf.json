{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IureDav",
  "version": "0.8.0",
  "identifier": "com.iurefficient.iuredav",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IureDav",
        "width": 1000,
        "height": 720,
        "minWidth": 740,
        "minHeight": 540,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Mount your Iurefficient as a system drive",
    "longDescription": "IureDav mounts an Iurefficient instance as a drive on your computer. It finds out what the server can really do before mounting it, instead of trusting what it advertises.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "fuse3"
        ],
        "desktopTemplate": "./linux/app.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/app.desktop"
      }
    },
    "resources": [],
    "externalBin": [
      "binaries/iuredav-rclone"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMUI0OEUxNjg1NjE1MjUKUldRbEZWWm80VWdiajlpRzB5WFRKY0RFZ01VVGN0TVMrV01LQjZWTUNTa3JsV0VoMFRWQTlmbmUK",
      "endpoints": [
        "https://github.com/ellaguno/iuredav/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "iuredav"
        ]
      }
    }
  }
}
